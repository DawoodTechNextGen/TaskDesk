# Keep logins alive for 2 hours of inactivity (PHP's default is 24 minutes,
# which logged users out mid-work). Every page calls session_start() itself,
# so this is set here rather than in PHP code. Guarded so hosts running PHP
# as FPM/CGI (which reject php_value) don't 500 - those read .user.ini instead.
<IfModule php_module>
    php_value session.gc_maxlifetime 7200
</IfModule>
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 7200
</IfModule>
<IfModule mod_php7.c>
    php_value session.gc_maxlifetime 7200
</IfModule>

# No directory listings anywhere (backups/ and uploads/ used to be browsable).
Options -Indexes

# Never served over the web: database dumps and SQL files, leftover temp
# files, and the candidates' proctoring webcam photos (those are only read
# server-side, into the assessment report PDF).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(backups|database|temp)(/|$) - [F,L]
    RewriteRule ^uploads/assessment_captures(/|$) - [F,L]
</IfModule>
